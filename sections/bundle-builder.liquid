{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundle-builder.js' | asset_url }}" defer></script>

{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign has_products = false
  for block in product_blocks
    if block.settings.product != blank
      assign has_products = true
      break
    endif
  endfor
-%}

{% if page.handle == 'bundle-builder' %}
<section class="bundle-builder color-{{ section.settings.color_scheme }}" data-bundle-builder>
  <div class="bundle-builder__wrap">
    <header class="bundle-builder__header">
      <h1 class="bundle-builder__heading">{{ section.settings.heading | default: 'Build Your Bundle' }}</h1>
      <p class="bundle-builder__intro">
        {{ section.settings.helper_text | default: 'Choose your favourite products and unlock bundle savings as you build.' }}
      </p>
    </header>

    <div class="bundle-builder__tabs" role="tablist" aria-label="Bundle product series">
      <button class="bundle-builder__tab is-active" type="button" role="tab" aria-selected="true" data-bundle-tab="zhen">
        Zhen Series
      </button>
      <button class="bundle-builder__tab" type="button" role="tab" aria-selected="false" data-bundle-tab="xin">
        Xin Series
      </button>
      <button class="bundle-builder__tab" type="button" role="tab" aria-selected="false" data-bundle-tab="accessories">
        Accessories
      </button>
    </div>

    {%- if has_products -%}
      <div class="bundle-builder__grid" data-bundle-grid>
        {%- for block in product_blocks -%}
          {%- liquid
            assign product = block.settings.product
            assign series = block.settings.series | default: 'zhen'
          -%}

          {%- if product != blank -%}
            {%- assign variant = product.selected_or_first_available_variant -%}
            <article
              class="bundle-builder__card{% unless series == 'zhen' %} is-hidden{% endunless %}"
              data-bundle-card
              data-series="{{ series }}"
              data-product-id="{{ product.id }}"
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price }}"
              data-title="{{ product.title | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="bundle-builder__image">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 520
                    | image_tag:
                      widths: '260, 360, 520',
                      sizes: '(min-width: 990px) 24vw, (min-width: 700px) 33vw, 50vw',
                      loading: 'lazy',
                      alt: product.title
                  }}
                {%- else -%}
                  <div class="bundle-builder__image-placeholder" aria-hidden="true">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}
              </div>

              <div class="bundle-builder__card-body">
                <h2 class="bundle-builder__title">{{ product.title }}</h2>
                <p class="bundle-builder__price">{{ variant.price | money }}</p>
                <button
                  class="bundle-builder__toggle"
                  type="button"
                  data-bundle-toggle
                  aria-pressed="false"
                  aria-label="Add {{ product.title | escape }} to bundle"
                >
                  Add to bundle
                </button>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="bundle-builder__empty-products">
        Add product blocks in the theme editor to make this bundle builder shoppable.
      </div>
    {%- endif -%}
  </div>

  <aside class="bundle-summary" data-bundle-summary aria-live="polite">
    <div class="bundle-summary__inner">
      <div>
        <p class="bundle-summary__eyebrow">Your bundle</p>
        <p class="bundle-summary__count" data-bundle-count>0 items selected</p>
      </div>

      <ul class="bundle-summary__items" data-bundle-items>
        <li class="bundle-summary__empty">No products selected yet.</li>
      </ul>

      <div class="bundle-summary__totals">
        <p class="bundle-summary__tier" data-bundle-tier>Choose 2 items to unlock 10% off.</p>
        <p class="bundle-summary__subtotal">
          Estimated subtotal
          <strong data-bundle-subtotal>{{ 0 | money }}</strong>
        </p>
      </div>

      <div class="bundle-summary__actions">
        <button class="bundle-summary__button" type="button" data-bundle-add disabled>
          Add bundle to cart
        </button>
        <p class="bundle-summary__feedback" data-bundle-feedback role="status"></p>
      </div>
    </div>
  </aside>
</section>
{% endif %}

{% schema %}
{
  "name": "Bundle Builder",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Bundle"
    },
    {
      "type": "textarea",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Choose products from each series and unlock bundle savings. Buy 2 for 10% off, 3 for 15% off, or 4+ for 20% off."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Bundle product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "select",
          "id": "series",
          "label": "Series tab",
          "default": "zhen",
          "options": [
            {
              "value": "zhen",
              "label": "Zhen Series"
            },
            {
              "value": "xin",
              "label": "Xin Series"
            },
            {
              "value": "accessories",
              "label": "Accessories"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder"
    }
  ]
}
{% endschema %}
